---
// The header's "Your bakery" link goes straight to the console when the API says there is a
// session. Its words are the same on every page (audit F14, 2026-11-10); only its address changes.
// The link is plain HTML in Base.astro, to the sign-in page, which with no script is still right:
// that page tells a visitor who has a sandbox so. This script runs only on pages that carry the
// guide's island, which are the pages the page policy lets call the API; the essays, the about page
// and the 404 have no script at all (ADR 0008).
---

<script>
  import { readSession, rememberedSignedIn, sessionLink, watchSession } from '../lib/session';

  const link = document.querySelector<HTMLAnchorElement>('a[data-session-link]');
  if (link) {
    watchSession((signedIn) => {
      const next = sessionLink(signedIn, location.pathname);
      link.href = next.href;
      link.textContent = next.label;
      if (next.current) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    // A page whose islands ask anyway shares that one answer. A page with none asks only when this
    // browser last saw a session, so an anonymous visitor to a static page logs nothing.
    if (rememberedSignedIn()) readSession().catch(() => undefined);
  }
</script>
