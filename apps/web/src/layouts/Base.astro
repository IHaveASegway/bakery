---
import '../styles/global.css';
import { shellFor, type Shell } from '../lib/shell';
import tokensCss from '../styles/tokens.css?raw';
import { chromeColor } from '../lib/tokens';
import SessionLink from '../components/SessionLink.astro';
import Tour from '../components/Tour';
import type { ScreenId } from '../lib/tour';
import { REPO, SITE_LAB } from '../lib/links';

interface Props {
  title: string;
  description: string;
  /** The screen whose guided tour the page carries; a page with none (the 404) has no tour. */
  screen?: ScreenId;
  /** The shell, when the page's path does not say it (src/lib/shell.ts). */
  shell?: Shell;
  /** A page that is one visitor's own (an order's status): kept out of search and the sitemap. */
  noindex?: boolean;
  /** A page with an island that calls the API but no tour: it runs the session link's script. */
  session?: boolean;
}
const { title, description, screen, noindex = false, session = false } = Astro.props;

// The public shell: the bakery's name, the nav and the footer, on every page. Plain links; a page
// with the tour also runs the small script that turns "Sign in" into "Console" (SessionLink.astro).
const NAV = [
  { href: '/menu/', label: 'Menu' },
  { href: '/catering/', label: 'Catering' },
  { href: '/how-its-built/', label: 'How it’s built' },
  { href: '/about/', label: 'About' },
  { href: '/status/', label: 'Status' },
];
// The last link is the visitor's way in. It is "Sign in" in the HTML, which is right with no script;
// the script at the foot turns it into "Console" when the API says there is a session.
const SESSION = { href: '/signin/', label: 'Sign in' };
const FOOTER = [
  { href: '/privacy/', label: 'Privacy' },
  { href: '/docs/api/', label: 'API reference' },
  { href: REPO, label: 'The repository' },
  { href: SITE_LAB, label: 'The lab, on ihaveasegway.com' },
];
const here = Astro.url.pathname;
// Prose for reading, shop for the storefront, app for the console (design brief, 2026-11-09).
const shell = Astro.props.shell ?? shellFor(here);
// The page's address as the site states it, and the share tags that repeat its title and
// description. The 404 is no page to point at, so it carries neither the canonical link nor the URL.
const isNotFound = /^\/404(\.html|\/)?$/.test(here);
const canonical = isNotFound || noindex ? null : new URL(here, Astro.site).href;
const current = (href: string) => (here === href || here.startsWith(href) ? 'page' : undefined);

// The browser chrome takes the page's background: one theme-color meta per OS scheme, read from
// tokens.css at build so no second copy of a color exists. There is no inline script, so the
// theme follows the OS.
const chrome = (['dark', 'light'] as const).map((scheme) => ({
  media: `(prefers-color-scheme: ${scheme})`,
  color: chromeColor(tokensCss, scheme),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    {chrome.map(({ media, color }) => (
      <meta name="theme-color" media={media} content={color} />
    ))}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Proof of Concept Bakery" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={`shell-${shell}`}>
    <a class="skip-link" href="#main">
      Skip to the page
    </a>
    {shell === 'app' ? (
      <header class="topbar">
        <a class="site-name" href="/" aria-current={here === '/' ? 'page' : undefined}>
          <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 15c0-5 4-9 9-9s9 4 9 9v2H3z" />
            <path d="M8 10l1.5 3M12 9v4M16 10l-1.5 3" />
          </svg>
          <span>Proof of Concept Bakery</span>
        </a>
        <span class="topbar-title">Console</span>
        <nav aria-label="The bakery" class="topbar-nav">
          <ul class="site-nav">
            {NAV.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={current(href)}>
                  {label}
                </a>
              </li>
            ))}
            <li>
              <a href={SESSION.href} aria-current={current(SESSION.href)} data-session-link>
                {SESSION.label}
              </a>
            </li>
          </ul>
        </nav>
      </header>
    ) : (
      <header class="masthead">
        <div class="masthead-inner">
          <a class="site-name" href="/" aria-current={here === '/' ? 'page' : undefined}>
            <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3 15c0-5 4-9 9-9s9 4 9 9v2H3z" />
              <path d="M8 10l1.5 3M12 9v4M16 10l-1.5 3" />
            </svg>
            <span>Proof of Concept Bakery</span>
          </a>
          <nav aria-label="The bakery">
            <ul class="site-nav">
              {NAV.map(({ href, label }) => (
                <li>
                  <a href={href} aria-current={current(href)}>
                    {label}
                  </a>
                </li>
              ))}
              <li>
                <a
                  class="session-link"
                  href={SESSION.href}
                  aria-current={current(SESSION.href)}
                  data-session-link
                >
                  {SESSION.label}
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </header>
    )}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class={screen ? 'site-footer with-tour' : 'site-footer'}>
      <div class="footer-inner">
        <nav aria-label="More">
          <ul class="footer-nav">
            {FOOTER.map(({ href, label }) => (
              <li>
                <a href={href} rel={href.startsWith('https:') ? 'noopener' : undefined}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <p>Everything here is made up: the bakery, its customers, their orders and their cards.</p>
      </div>
    </footer>
    {screen && <Tour screen={screen} client:idle />}
    {(screen || session) && <SessionLink />}
  </body>
</html>
