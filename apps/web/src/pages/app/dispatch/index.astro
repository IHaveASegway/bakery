---
import Base from '../../../layouts/Base.astro';
import DispatchWorkspace from '../../../components/workspaces/Dispatch';
import attribution from '../../../../public/app/dispatch/data/ATTRIBUTION.txt?raw';
import { ODBL_URL, OSM_COPYRIGHT_URL, routeCredit } from '../../../lib/dispatch';

const { orsVersion } = routeCredit(attribution);
---

<Base
  title="Dispatch | Proof of Concept Bakery"
  description="One day's delivery stops on a map of Salt Lake City, the server's proposed plan, the plan VROOM makes in your browser, the two compared, and the one that is published."
  screen="dispatch"
>
  <h1>Dispatch</h1>
  <p class="lead-line">
    One day's confirmed stops, one to four vans, and two plans the Dispatch object checks before one
    is published.
  </p>
  <DispatchWorkspace client:load />
  <section>
    <h2>Map and route data</h2>
    <p class="fine">
      <a href={OSM_COPYRIGHT_URL}>© OpenStreetMap contributors</a>, under the{' '}
      <a href={ODBL_URL}>Open Database License 1.0</a>. Travel times and reachable areas were
      computed offline with openrouteservice {orsVersion}, self-hosted, over an OpenStreetMap
      extract, by <code>tools/route-data/</code> in this repository. Free-flow times: no traffic.
      The places are public places; the bakery is made up.
    </p>
  </section>
  <p>
    <a href="/app/">Back to the console</a>
  </p>
</Base>
