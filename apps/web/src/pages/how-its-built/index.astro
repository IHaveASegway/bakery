---
import Base from '../../layouts/Base.astro';
import { GROUPS, ONE_LINE, RECRUITER_LINE, principleOf, sections } from '../../lib/how-its-built';
import { ESSAY_PAGES, SITE_LAB } from '../../lib/links';
import { decisionRows } from '../../guide/decisions';

// How it's built (Q6 · Q-public, Q32 · Q-links, Q33 · Q-principles): one section per principle,
// from the data the guide reads (lib/how-its-built.ts), so the page and the guide cannot drift. A
// static page with no island and no script: the strict policy, like the 404. Every principle has
// an essay (lib/links.ts, ESSAYS), listed once after the contents and linked from its section by
// title. Three pairs of sections share one: the two idempotency sections, CQRS and load, and the
// sandbox and no personal data.
const essays = ESSAY_PAGES;
// The decision table: each principle's tool, why it is used here and when it would be the wrong
// one, in the guide's own words (guide/decisions.ts), with the essay that argues it.
const decisions = decisionRows();
const groups = (['lab', 'new', 'demo'] as const).map((group) => ({
  group,
  ...GROUPS[group],
  sections: sections()
    .filter((s) => s.group === group)
    .map((s) => ({
      ...s,
      links: principleOf(s),
    })),
}));
---

<Base
  title="How it’s built | Proof of Concept Bakery"
  description="Every technique Proof of Concept Bakery runs: the problem, the technique, how it works here, where it runs, how to see it, and the lab page and ADR that explain it."
>
  <div class="prose">
    <h1>How it’s built</h1>
    <p class="lead">{ONE_LINE}</p>
    <p>{RECRUITER_LINE}</p>
    <p>
      Each section below takes one principle in the same order: the problem the bakery has, the
      technique chosen, how it works here and what it costs, where it runs, and what you can do to
      see it. Then it links the{' '}
      <a href={SITE_LAB} rel="noopener">
        lab page
      </a>{' '}
      that explains the principle on its own, where there is one, and the decision record (ADR) that
      chose it. The guide on every screen links back here.
    </p>

    <h2 id="decisions-title">Why each tool, and when not</h2>
    <p>
      One row a principle: the tool, why the bakery uses it here, and when it would be the wrong
      tool. The guide says the same beside each thing it explains, and each essay makes the case.
    </p>
    <div class="table-scroll" role="region" aria-labelledby="decisions-title" tabindex="0">
      <table class="decisions">
        <thead>
          <tr>
            <th scope="col">Tool</th>
            <th scope="col">Why here</th>
            <th scope="col">When it is the wrong tool</th>
            <th scope="col">The essay</th>
          </tr>
        </thead>
        <tbody>
          {decisions.map((d) => (
            <tr id={`decision-${d.principle.id}`}>
              <th scope="row">
                <a href={`#${d.principle.id}`}>{d.principle.name}</a>
              </th>
              <td>{d.why}</td>
              <td>{d.whenNot}</td>
              <td>
                {d.principle.essay && <a href={d.principle.essay.url}>{d.principle.essay.title}</a>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <nav aria-labelledby="contents-title">
      <h2 id="contents-title">Contents</h2>
      {groups.map(({ title, sections }) => (
        <>
          <h3>{title}</h3>
          <ul class="contents">
            {sections.map((s) => (
              <li>
                <a href={`#${s.id}`}>{s.name}</a>
              </li>
            ))}
          </ul>
        </>
      ))}
      <h3 id="essays-title">The essays</h3>
      <p>
        One for each lab principle, on what the bakery does for real that the lab page shows in the
        small; one for each principle with no lab page yet, which the bakery explains itself; and
        two on how the demo itself is run. Where two sections tell one story, they share an essay.
      </p>
      <ul class="contents" aria-labelledby="essays-title">
        {essays.map((e) => (
          <li>
            <a href={e.path}>{e.title}</a>
          </li>
        ))}
      </ul>
    </nav>

    {groups.map(({ group, title, intro, sections }) => (
      <section aria-labelledby={`group-${group}`}>
        <h2 id={`group-${group}`}>{title}</h2>
        <p>{intro}</p>
        {sections.map((s) => (
          <section class="principle" id={s.id} aria-labelledby={`${s.id}-title`}>
            <h3 id={`${s.id}-title`}>{s.name}</h3>
            <dl>
              <dt>The problem</dt>
              <dd>{s.problem}</dd>
              <dt>The technique</dt>
              <dd>{s.technique}</dd>
              <dt>How it works here</dt>
              <dd>{s.how}</dd>
              <dt>Where it runs</dt>
              <dd>{s.where}</dd>
              <dt>See it yourself</dt>
              <dd>
                {s.see} <a href={s.screen.href}>{s.screen.label}</a>.
              </dd>
            </dl>
            <p class="links">
              <strong>Read more:</strong>{' '}
              {s.links.labUrl === undefined ? (
                <span>no lab page yet</span>
              ) : (
                <a href={s.links.labUrl} rel="noopener">
                  the {s.lab}
                </a>
              )}
              {' · '}
              <a href={s.links.adrUrl} rel="noopener">
                ADR {s.adr}
              </a>
              {s.links.essay !== undefined && (
                <>
                  {' · '}
                  <a href={s.links.essay.url}>{s.links.essay.title}</a>
                </>
              )}
            </p>
          </section>
        ))}
      </section>
    ))}
  </div>
</Base>
