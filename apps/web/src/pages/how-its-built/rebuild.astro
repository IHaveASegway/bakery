        </li>
      ))}
    </ul>
    <p class="hint">
      Back to <a href={howUrl('backfill')}>the rebuild principle on How it’s built</a>, or to{' '}
      <a href={SITE_LAB} rel="noopener">
        the lab
      </a>
      .
    </p>
  </article>
</Base>
