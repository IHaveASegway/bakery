---
import Base from '../layouts/Base.astro';
import Inbox from '../components/Inbox';
---

<Base
  title="Inbox | Proof of Concept Bakery"
  description="Every message the made-up bakery sends lands in your private sandbox's inbox: receipts, ready notices and campaigns, with their simulated opens and clicks."
  screen="inbox"
>
  <h1>Inbox</h1>
  <p>
    The bakery sends no email. Receipts, ready notices, quotes, reminders and campaigns all land
    here, in your private sandbox, and are deleted with it at 10:00 UTC. Nothing here asks for your
    name, email, phone or address.
  </p>
  <Inbox client:load />
</Base>
