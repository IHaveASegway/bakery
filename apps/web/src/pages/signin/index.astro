---
import Base from '../../layouts/Base.astro';
import DemoAccount from '../../components/DemoAccount';
import Guest, { AlreadyIn } from '../../components/Guest';
import { signinUrl } from '../../lib/api';
import SignInError from '../../components/SignInError';

// Three ways in, the quickest first (decision G2, 2026-11-09): a guest, a demo account, or an
// account the visitor has. The guest and demo-account flows go on to the page named by `next`
// (src/lib/next.ts): with none, a guest goes to the menu and an account to the console. Google and
// GitHub keep their server-side redirect. Turnstile loads here at once; the menu and the checkout
// load it only when the visitor presses Start ordering (components/Guest.tsx, StartHere). A visitor
// who already has a sandbox, sent here by the header from a page with no script, is told so first.
---

<Base
  title="Sign in | Proof of Concept Bakery"
  description="Three ways into a private sandbox: a guest, a demo account, or Google or GitHub."
  screen="signin"
>
  <h1>Get your own bakery</h1>
  <p class="page-lead">
    Each way in gives you a private sandbox, deleted at 10:00 UTC, and the bakery never stores your
    name or email. <a href="/privacy/">What it keeps and for how long</a>.
  </p>

  <SignInError client:load />
  <AlreadyIn client:load />

  <div class="ways-in">
    <Guest client:load />
    <DemoAccount client:load />
    <section aria-labelledby="providers" class="way-in" data-tour="signin-providers">
      <h2 id="providers">Use Google or GitHub</h2>
      <p>A sandbox that follows you. The provider tells the bakery only a number, kept hashed.</p>
      <ul class="choices">
        <li>
          <a class="btn btn-secondary" href={signinUrl('google')}>
            Continue with Google
          </a>
        </li>
        <li>
          <a class="btn btn-secondary" href={signinUrl('github')}>
            Continue with GitHub
          </a>
        </li>
      </ul>
    </section>
  </div>
</Base>
