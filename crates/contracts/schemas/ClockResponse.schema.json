{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClockResponse",
  "description": "The business clock after an advance.",
  "type": "object",
  "properties": {
    "business_now": {
      "description": "Business time now, such as `2026-11-07T09:42:10-07:00`.",
      "type": "string"
    },
    "clock_offset_s": {
      "type": "integer",
      "format": "int64"
    },
    "clock_v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "clock_offset_s",
    "clock_v",
    "business_now"
  ]
}
