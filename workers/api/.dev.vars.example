# Names only. Copy to .dev.vars (git-ignored, never committed) and fill in sandbox or test values
# locally; in production each is a Worker secret (docs/security.md, "Secrets inventory").

# Signs the session and OAuth cookies (HMAC-SHA256); at least 32 bytes of any text. PR 3.
SESSION_HMAC_KEY=
# Optional: the previous signing key, accepted for verification only during a rotation
# (docs/operations.md, "Rotate secrets"). Leave unset otherwise. PR 3.
SESSION_HMAC_KEY_PREV=
# Derives account ids from provider ids, so no raw id is stored. PR 3.
ACCOUNT_HMAC_KEY=
# The Stripe sandbox's restricted key; the Worker refuses any key that is not a sandbox key. PR 5.
STRIPE_SECRET_KEY=
# Verifies Stripe webhook signatures. PR 5.
STRIPE_WEBHOOK_SECRET=
# The Google OAuth client's id. Public by nature, but it moves into wrangler.jsonc only at launch
# (PR 11). PR 3.
GOOGLE_CLIENT_ID=
# The Google OAuth client's secret, for the code exchange. PR 3.
GOOGLE_CLIENT_SECRET=
# The GitHub OAuth app's client id; as GOOGLE_CLIENT_ID. PR 3.
GITHUB_CLIENT_ID=
# The GitHub OAuth app's secret, for the code exchange. PR 3.
GITHUB_CLIENT_SECRET=
# Turnstile's secret for siteverify; Turnstile's documented test secret locally. PR 3.
TURNSTILE_SECRET=

# Local overrides of public vars. A var set here wins over wrangler.jsonc on `wrangler dev`.
# The storefront on `astro dev`, so the Origin check and the redirects after sign-in match it:
# ALLOWED_ORIGIN=http://127.0.0.1:8787
# This API on `wrangler dev`, the base of the OAuth redirect URIs a local client registers:
# API_ORIGIN=http://127.0.0.1:8788

# Optional, local runs only: every new sandbox gets this seed instead of a random one, so two
# sandboxes born from it match (scripts/smoke-crm.sh compares their inbox engagement). Honored
# only when API_ORIGIN is a loopback host, a whole number below 2^53. PR 8.
# SANDBOX_SEED=42

# Local fake provider (scripts/fake-providers.mjs); loopback hosts only. The Worker honors these
# only when the host is 127.0.0.1 or localhost, logs provider_override_refused for anything
# else, and never reads them from wrangler.jsonc. With the fake running on its default port:
# GOOGLE_ISSUER=http://127.0.0.1:8790/google
# GITHUB_AUTHORIZE_URL=http://127.0.0.1:8790/github/login/oauth/authorize
# GITHUB_TOKEN_URL=http://127.0.0.1:8790/github/login/oauth/access_token
# GITHUB_USER_URL=http://127.0.0.1:8790/github/user
# TURNSTILE_SITEVERIFY_URL=http://127.0.0.1:8790/turnstile/siteverify
# and the fake's own client ids and secrets, which are not secrets:
# GOOGLE_CLIENT_ID=fake-google-client
# GOOGLE_CLIENT_SECRET=fake-google-client-secret
# GITHUB_CLIENT_ID=fake-github-client
# GITHUB_CLIENT_SECRET=fake-github-client-secret

# Local fake of Stripe's API (scripts/fake-stripe.mjs, port 8791); loopback hosts only, as above.
# Stripe's API origin; unset means https://api.stripe.com. PR 5.
STRIPE_API_BASE=
# Optional: sent as Stripe-Version when set; unset means the account's default API version. PR 5.
STRIPE_API_VERSION=
# With the fake running, these three lines point the Worker at it; its key and webhook secret
# are test-shaped fakes, not secrets:
# STRIPE_API_BASE=http://127.0.0.1:8791
# STRIPE_SECRET_KEY=rk_test_not_a_key
# STRIPE_WEBHOOK_SECRET=whsec_not_a_secret

# The status page's counters (PR 13): the 15-minute cron runs the kept Analytics Engine queries
# with these two and stores the answer in Control. With either unset the refresh is skipped
# (analytics_unconfigured) and GET /v1/status says counters_state "unavailable".
# A Cloudflare account token with Account Analytics Read only.
ANALYTICS_API_TOKEN=
# The account the bakery_events dataset is in; a secret only because the logs are public.
ANALYTICS_ACCOUNT_ID=
# Local fake of the SQL API (scripts/fake-analytics.mjs, port 8792); loopback hosts only, as
# above, and analytics_base_refused is logged for any other. Unset means
# https://api.cloudflare.com/client/v4. With the fake running, these three lines point the
# Worker at it; its token and account id are fakes, not secrets:
# ANALYTICS_API_BASE=http://127.0.0.1:8792
# ANALYTICS_API_TOKEN=fake-analytics-token
# ANALYTICS_ACCOUNT_ID=0000000000000000000000000000fake
ANALYTICS_API_BASE=
