// The Worker bakery-api (docs/delivery.md, "Toolchain pins"). Local-only until PR 11: nothing here
// is deployed before launch, and no account id or secret is ever written in this file.
{
  "name": "bakery-api",
  "main": "build/worker/shim.mjs", // worker-build's output
  // The newest date the workerd inside Wrangler 4.152.0 accepts; 2026-11-04 fails to start there.
  "compatibility_date": "2026-11-04",
  "build": { "command": "worker-build --release" },

  // The deploy target from PR 11. Harmless on `wrangler dev`, which ignores routes.
  "routes": [{ "pattern": "api.bakery.ihaveasegway.com", "custom_domain": true }],
  "workers_dev": false, // the zone, with its WAF rule, is the only way in
  "preview_urls": false, // a Worker with a Durable Object gets no Version URLs anyway
  "limits": { "cpu_ms": 300 }, // twice the planned argon2id hash; applies on Workers Paid (PR 11)
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }, // invocation logs record location fields

  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "Control" },
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "SANDBOX", "class_name": "Sandbox" },
      { "name": "CATALOG", "class_name": "Catalog" },
      { "name": "ORDER", "class_name": "Order" },
      { "name": "KITCHEN", "class_name": "Kitchen" },
      { "name": "SIMULATOR", "class_name": "Simulator" },
      { "name": "BILLING", "class_name": "Billing" },
      { "name": "SCHEDULE", "class_name": "Schedule" },
      { "name": "CATERING", "class_name": "CateringEvent" },
      { "name": "CUSTOMER", "class_name": "Customer" },
      { "name": "CRM", "class_name": "Crm" },
      { "name": "INBOX", "class_name": "Inbox" },
      { "name": "DISPATCH", "class_name": "Dispatch" },
    ],
  },
  // Declarative class lifecycle: each change is a deploy and a rollback boundary.
  "exports": {
    "Control": { "type": "durable-object", "storage": "sqlite" },
    "Account": { "type": "durable-object", "storage": "sqlite" },
    "Sandbox": { "type": "durable-object", "storage": "sqlite" },
    "Catalog": { "type": "durable-object", "storage": "sqlite" },
    "Order": { "type": "durable-object", "storage": "sqlite" },
    "Kitchen": { "type": "durable-object", "storage": "sqlite" },
    "Simulator": { "type": "durable-object", "storage": "sqlite" },
    "Billing": { "type": "durable-object", "storage": "sqlite" },
    "Schedule": { "type": "durable-object", "storage": "sqlite" },
    "CateringEvent": { "type": "durable-object", "storage": "sqlite" },
    "Customer": { "type": "durable-object", "storage": "sqlite" },
    "Crm": { "type": "durable-object", "storage": "sqlite" },
    "Inbox": { "type": "durable-object", "storage": "sqlite" },
    "Dispatch": { "type": "durable-object", "storage": "sqlite" },
  },

  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "bakery-events" }],
    "consumers": [
      {
        "queue": "bakery-events",
        "max_batch_size": 10,
        // A batch goes as soon as a message is there: the board's change must reach a second
        // browser within a second (docs/roadmap.md, PR 4), and the default wait is 5 s on the
        // platform and 1 s locally (Queues configuration, as of 2026-11-05,
        // https://developers.cloudflare.com/queues/configuration/configure-queues/). Operations
        // are counted per message, so smaller batches cost no Queue operations.
        "max_batch_timeout": 0,
        "max_retries": 3,
        "dead_letter_queue": "bakery-events-dlq",
      },
      // The DLQ writer: each message and its last error into the owning Sandbox's
      // dead_letters, then acked. It has no dead-letter queue of its own.
      { "queue": "bakery-events-dlq", "max_batch_size": 10, "max_retries": 3 },
    ],
  },

  // One data point per event (docs/operations.md, "Observability"): sandbox_created,
  // order_placed, payment_succeeded, payment_failed, refund_issued, wipe and dlq, each holding
  // the event's name and counts, never a visitor, a sandbox or an IP. Written fire and forget;
  // the status page reads them through the SQL API from the 15-minute cron (PR 13).
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "bakery_events" }],

  // The wipe at 10:00 UTC, and the sweep that retries any sandbox the wipe missed (the breaker
  // joins it in PR 11) and refreshes the status page's counters (PR 13). Each only asks Control
  // to start or to store; Control's alarm does the wipe's work.
  "triggers": { "crons": ["0 10 * * *", "*/15 * * * *"] },

  // The free layer of admission, before Control (docs/architecture.md, "Creating a sandbox"):
  // per IP hash on POST /v1/sandboxes, per session on other commands and on the kitchen
  // socket's upgrades (docs/cost.md, "Guardrails": 6 a minute), and per API token id on every
  // request a token makes, at the session's command rate (PR 10; docs/security.md, "The API
  // token"). The namespace ids are the account's own labels for the limits, not secrets.
  "ratelimits": [
    {
      "name": "SANDBOX_CREATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 1, "period": 60 },
    },
    { "name": "COMMAND_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "UPGRADE_LIMIT", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } },
    { "name": "TOKEN_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
  ],

  "vars": {
    "ALLOWED_ORIGIN": "https://bakery.ihaveasegway.com",
    // The API's own origin, for the OAuth redirect URIs, which must match the registered ones
    // exactly. Not read from the request: `wrangler dev` rewrites its host to the route's.
    "API_ORIGIN": "https://api.bakery.ihaveasegway.com",
    "SANDBOX_CAP": "300",
    "GUEST_SANDBOX_CAP": "100",
    "DEMO_ACCOUNT_CAP": "100",
    "ACCOUNT_SANDBOX_CAP": "3",
    // Minutes of simulated traffic a sandbox may run in a UTC day (docs/cost.md, "Guardrails").
    "TRAFFIC_MINUTES_CAP": "30",
  },
}
